{
  "name": "StaffAccount",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "title": "Email Address",
      "unique": true
    },
    "password_hash": {
      "type": "string",
      "title": "Password Hash"
    },
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "last_login": {
      "type": "string",
      "title": "Last Login Date"
    }
  },
  "required": [
    "email",
    "password_hash",
    "full_name"
  ]
}