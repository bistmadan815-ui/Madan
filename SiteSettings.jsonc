{
  "name": "StaffTask",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "assigned_to": {
      "type": "string",
      "title": "Assigned To"
    },
    "due_date": {
      "type": "string",
      "title": "Due Date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed"
      ],
      "default": "pending",
      "title": "Status"
    }
  },
  "required": [
    "title"
  ]
}